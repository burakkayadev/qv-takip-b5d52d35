<?xml version="1.0" encoding="utf-8"?>
<!-- Uygulama simgesine uzun basınca çıkan kısayollar + Google Assistant App Actions (OPEN_APP_FEATURE) -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:targetPackage="io.github.burakkayadev.qvtakip">
            <url-template android:value="https://burakkayadev.github.io/qv-takip-b5d52d35/{?feature}&amp;voice=1" />
            <parameter
                android:name="feature"
                android:key="feature" />
        </intent>
    </capability>

    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="today_deliveries"
        android:shortcutLongLabel="@string/sc_deliveries"
        android:shortcutShortLabel="@string/sc_deliveries_short">
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/syn_deliveries" />
        </capability-binding>
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://burakkayadev.github.io/qv-takip-b5d52d35/?tab=deliveries&amp;filter=today&amp;voice=1"
            android:targetClass="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:targetPackage="io.github.burakkayadev.qvtakip" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="today_returns"
        android:shortcutLongLabel="@string/sc_returns"
        android:shortcutShortLabel="@string/sc_returns_short">
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/syn_returns" />
        </capability-binding>
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://burakkayadev.github.io/qv-takip-b5d52d35/?tab=returns&amp;filter=today&amp;voice=1"
            android:targetClass="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:targetPackage="io.github.burakkayadev.qvtakip" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="overdue_returns"
        android:shortcutLongLabel="@string/sc_overdue"
        android:shortcutShortLabel="@string/sc_overdue_short">
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/syn_overdue" />
        </capability-binding>
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://burakkayadev.github.io/qv-takip-b5d52d35/?tab=returns&amp;filter=overdue&amp;voice=1"
            android:targetClass="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:targetPackage="io.github.burakkayadev.qvtakip" />
    </shortcut>

</shortcuts>
